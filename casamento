<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Convite de Casamento | L & N</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Montserrat:wght@300;400;500;600;700&family=Great+Vibes&display=swap" rel="stylesheet">

  <style>
    :root {
      --terracotta: #A0522D;
      --terracotta-dark: #6f321d;
      --terracotta-soft: #c77852;
      --gold: #d9a441;
      --cream: #fff8ef;
      --beige: #efe1cf;
      --brown: #2b1710;
      --text: #3a261c;
      --white: #ffffff;
      --shadow: 0 22px 60px rgba(50, 24, 13, 0.22);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Montserrat', sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at top left, rgba(160, 82, 45, 0.22), transparent 32%),
        radial-gradient(circle at bottom right, rgba(217, 164, 65, 0.18), transparent 30%),
        linear-gradient(135deg, #fff7ed 0%, #f0dcc5 48%, #fffaf4 100%);
      min-height: 100vh;
      overflow-x: hidden;
    }

    .noise {
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: 0.08;
      z-index: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.7' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    }

    .hidden {
      display: none !important;
    }

    .intro-screen {
      position: fixed;
      inset: 0;
      z-index: 20;
      display: grid;
      place-items: center;
      padding: 28px;
      background:
        radial-gradient(circle at 50% 20%, rgba(255, 248, 239, 0.92), rgba(239, 225, 207, 0.92)),
        linear-gradient(135deg, #f6dfca, #fff9f1);
      transition: opacity 0.9s ease, visibility 0.9s ease;
    }

    .intro-screen.opened {
      opacity: 0;
      visibility: hidden;
    }

    .intro-card {
      width: min(620px, 100%);
      text-align: center;
      position: relative;
      animation: fadeUp 1s ease both;
    }

    .intro-title {
      font-family: 'Great Vibes', cursive;
      font-size: clamp(3.8rem, 12vw, 7rem);
      color: var(--terracotta-dark);
      font-weight: 400;
      line-height: 0.9;
      margin-bottom: 18px;
      text-shadow: 0 8px 22px rgba(160, 82, 45, 0.18);
    }

    .intro-subtitle {
      text-transform: uppercase;
      letter-spacing: 0.28em;
      font-size: 0.78rem;
      color: var(--terracotta-dark);
      margin-bottom: 34px;
      font-weight: 600;
    }

    .envelope-wrap {
      position: relative;
      width: min(420px, 88vw);
      height: 270px;
      margin: 0 auto 36px;
      perspective: 1000px;
      cursor: pointer;
      filter: drop-shadow(0 30px 30px rgba(90, 43, 24, 0.28));
    }

    .envelope {
      position: absolute;
      inset: 0;
      border-radius: 16px;
      background: linear-gradient(145deg, #f7e2cc, #d9a47d);
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.55);
      box-shadow: inset 0 0 0 1px rgba(111, 50, 29, 0.14);
    }

    .envelope::before,
    .envelope::after {
      content: "";
      position: absolute;
      inset: 0;
    }

    .envelope::before {
      clip-path: polygon(0 0, 50% 56%, 100% 0);
      background: linear-gradient(180deg, #edc7a7, #d79f77);
      transform-origin: top;
      transition: transform 0.9s ease;
      z-index: 4;
    }

    .envelope::after {
      clip-path: polygon(0 100%, 50% 42%, 100% 100%);
      background: linear-gradient(0deg, #c98762, #edc4a2);
      z-index: 5;
    }

    .envelope-left,
    .envelope-right {
      position: absolute;
      inset: 0;
      z-index: 3;
    }

    .envelope-left {
      clip-path: polygon(0 0, 52% 50%, 0 100%);
      background: linear-gradient(90deg, #d49a72, #f3d0b3);
    }

    .envelope-right {
      clip-path: polygon(100% 0, 48% 50%, 100% 100%);
      background: linear-gradient(270deg, #c7835f, #eec5a5);
    }

    .letter-peek {
      position: absolute;
      left: 50%;
      bottom: 34px;
      width: 78%;
      height: 190px;
      transform: translateX(-50%);
      border-radius: 14px 14px 4px 4px;
      background:
        linear-gradient(rgba(255,255,255,0.86), rgba(255,255,255,0.86)),
        repeating-linear-gradient(0deg, transparent 0 28px, rgba(160,82,45,0.08) 29px 30px);
      z-index: 2;
      box-shadow: 0 10px 25px rgba(80, 38, 20, 0.16);
      transition: transform 0.9s ease;
    }

    .wax-seal {
      position: absolute;
      left: 50%;
      top: 54%;
      transform: translate(-50%, -50%);
      width: 94px;
      height: 94px;
      border-radius: 50%;
      z-index: 8;
      display: grid;
      place-items: center;
      background:
        radial-gradient(circle at 35% 28%, #c97955 0 11%, transparent 12%),
        radial-gradient(circle at 70% 72%, #793319 0 10%, transparent 11%),
        radial-gradient(circle at 45% 45%, #b85b35, #7e351d 68%, #562111 100%);
      box-shadow:
        inset 8px 8px 18px rgba(255,255,255,0.16),
        inset -10px -12px 18px rgba(49,15,5,0.28),
        0 12px 24px rgba(78,31,15,0.35);
      color: #f7d9aa;
      font-family: 'Cormorant Garamond', serif;
      font-size: 2.15rem;
      font-weight: 700;
      letter-spacing: -0.05em;
      border: 1px solid rgba(255, 226, 178, 0.26);
    }

    .wax-seal::before {
      content: "";
      position: absolute;
      inset: 9px;
      border-radius: 50%;
      border: 1px solid rgba(255, 224, 179, 0.36);
    }

    .open-invite {
      border: 0;
      padding: 16px 30px;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--terracotta), var(--terracotta-dark));
      color: white;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 0 15px 32px rgba(160, 82, 45, 0.33);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .open-invite:hover {
      transform: translateY(-3px);
      box-shadow: 0 20px 42px rgba(160, 82, 45, 0.42);
    }

    .intro-hint {
      margin-top: 14px;
      font-size: 0.82rem;
      color: rgba(58, 38, 28, 0.68);
    }

    .site {
      position: relative;
      z-index: 1;
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 1s ease, transform 1s ease;
    }

    .site.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .hero {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 90px 22px 64px;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: "";
      position: absolute;
      width: 620px;
      height: 620px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(160,82,45,0.18), transparent 66%);
      top: -190px;
      right: -220px;
    }

    .hero-panel {
      width: min(980px, 100%);
      padding: clamp(34px, 7vw, 78px);
      text-align: center;
      border-radius: 34px;
      background: rgba(255, 248, 239, 0.78);
      backdrop-filter: blur(16px);
      box-shadow: var(--shadow);
      border: 1px solid rgba(255, 255, 255, 0.72);
      position: relative;
      overflow: hidden;
    }

    .hero-panel::before,
    .hero-panel::after {
      content: "";
      position: absolute;
      border: 1px solid rgba(160,82,45,0.22);
      border-radius: 30px;
      inset: 16px;
      pointer-events: none;
    }

    .monogram {
      width: 98px;
      height: 98px;
      margin: 0 auto 24px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      color: var(--terracotta-dark);
      font-family: 'Cormorant Garamond', serif;
      font-size: 2.45rem;
      font-weight: 700;
      background: linear-gradient(135deg, rgba(217,164,65,0.32), rgba(255,255,255,0.7));
      border: 1px solid rgba(217, 164, 65, 0.58);
      box-shadow: inset 0 0 22px rgba(217,164,65,0.2), 0 14px 28px rgba(95,50,27,0.12);
    }

    .eyebrow {
      text-transform: uppercase;
      letter-spacing: 0.33em;
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--terracotta);
      margin-bottom: 16px;
    }

    h1 {
      font-family: 'Great Vibes', cursive;
      color: var(--terracotta-dark);
      font-size: clamp(4.4rem, 14vw, 9rem);
      font-weight: 400;
      line-height: 0.88;
      margin-bottom: 22px;
    }

    .hero-date {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(1.6rem, 4vw, 2.5rem);
      color: var(--brown);
      font-weight: 700;
      margin-bottom: 18px;
    }

    .hero-text {
      max-width: 680px;
      margin: 0 auto 32px;
      line-height: 1.8;
      font-size: 1rem;
      color: rgba(58, 38, 28, 0.82);
    }

    .actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 14px;
    }

    .btn {
      text-decoration: none;
      border-radius: 999px;
      padding: 14px 24px;
      font-size: 0.86rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .btn-primary {
      color: #fff;
      background: linear-gradient(135deg, var(--terracotta), var(--terracotta-dark));
      box-shadow: 0 14px 28px rgba(160, 82, 45, 0.28);
    }

    .btn-secondary {
      color: var(--terracotta-dark);
      background: rgba(255,255,255,0.62);
      border: 1px solid rgba(160,82,45,0.22);
    }

    .btn:hover {
      transform: translateY(-3px);
    }

    .section {
      padding: 88px 22px;
      position: relative;
    }

    .container {
      width: min(1120px, 100%);
      margin: 0 auto;
    }

    .section-title {
      text-align: center;
      margin-bottom: 42px;
    }

    .section-title span {
      color: var(--terracotta);
      text-transform: uppercase;
      letter-spacing: 0.28em;
      font-size: 0.75rem;
      font-weight: 700;
    }

    .section-title h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(2.4rem, 7vw, 4.3rem);
      color: var(--terracotta-dark);
      margin-top: 8px;
      font-weight: 700;
    }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .card {
      background: rgba(255, 248, 239, 0.74);
      border: 1px solid rgba(255,255,255,0.72);
      border-radius: 28px;
      padding: 32px;
      box-shadow: 0 16px 36px rgba(96, 48, 25, 0.12);
      backdrop-filter: blur(12px);
      transition: transform 0.25s ease;
    }

    .card:hover {
      transform: translateY(-6px);
    }

    .card-icon {
      width: 56px;
      height: 56px;
      border-radius: 18px;
      display: grid;
      place-items: center;
      font-size: 1.45rem;
      background: linear-gradient(135deg, rgba(160,82,45,0.16), rgba(217,164,65,0.22));
      margin-bottom: 22px;
    }

    .card h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.8rem;
      color: var(--terracotta-dark);
      margin-bottom: 10px;
    }

    .card p {
      line-height: 1.75;
      color: rgba(58, 38, 28, 0.76);
      font-size: 0.96rem;
    }

    .timeline {
      display: grid;
      gap: 18px;
      max-width: 760px;
      margin: 0 auto;
    }

    .timeline-item {
      display: grid;
      grid-template-columns: 104px 1fr;
      gap: 18px;
      align-items: stretch;
    }

    .timeline-time {
      border-radius: 24px;
      background: var(--terracotta);
      color: #fff;
      display: grid;
      place-items: center;
      font-weight: 800;
      box-shadow: 0 12px 26px rgba(160,82,45,0.24);
    }

    .timeline-content {
      border-radius: 24px;
      padding: 24px;
      background: rgba(255,255,255,0.62);
      border: 1px solid rgba(160,82,45,0.14);
    }

    .timeline-content h3 {
      color: var(--terracotta-dark);
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.55rem;
      margin-bottom: 6px;
    }

    .gift-box {
      text-align: center;
      max-width: 760px;
      margin: 0 auto;
      background: linear-gradient(145deg, rgba(255,248,239,0.84), rgba(246,224,205,0.76));
      border-radius: 34px;
      padding: clamp(30px, 7vw, 58px);
      box-shadow: var(--shadow);
      border: 1px solid rgba(255,255,255,0.78);
    }

    .gift-box p {
      line-height: 1.85;
      margin-bottom: 24px;
      color: rgba(58, 38, 28, 0.8);
    }

    .rsvp-form {
      max-width: 720px;
      margin: 0 auto;
      display: grid;
      gap: 16px;
      background: rgba(255, 248, 239, 0.76);
      padding: clamp(28px, 6vw, 48px);
      border-radius: 34px;
      box-shadow: var(--shadow);
      border: 1px solid rgba(255,255,255,0.78);
    }

    label {
      font-weight: 700;
      color: var(--terracotta-dark);
      font-size: 0.9rem;
    }

    input,
    select,
    textarea {
      width: 100%;
      border: 1px solid rgba(160,82,45,0.22);
      border-radius: 18px;
      padding: 15px 16px;
      font-family: 'Montserrat', sans-serif;
      font-size: 0.95rem;
      background: rgba(255,255,255,0.72);
      outline: none;
      color: var(--text);
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: var(--terracotta);
      box-shadow: 0 0 0 4px rgba(160,82,45,0.10);
    }

    textarea {
      min-height: 110px;
      resize: vertical;
    }

    .submit-btn {
      border: 0;
      padding: 16px 22px;
      border-radius: 999px;
      color: #fff;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      background: linear-gradient(135deg, var(--terracotta), var(--terracotta-dark));
      cursor: pointer;
      box-shadow: 0 14px 28px rgba(160,82,45,0.28);
    }

    footer {
      text-align: center;
      padding: 44px 20px 60px;
      color: rgba(58,38,28,0.72);
    }

    footer .footer-logo {
      font-family: 'Great Vibes', cursive;
      font-size: 3.2rem;
      color: var(--terracotta-dark);
      margin-bottom: 8px;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 820px) {
      .cards-grid {
        grid-template-columns: 1fr;
      }

      .timeline-item {
        grid-template-columns: 1fr;
      }

      .timeline-time {
        min-height: 58px;
      }

      .section {
        padding: 70px 18px;
      }
    }
  </style>
</head>
<body>
  <div class="noise"></div>

  <!-- TELA INICIAL COM ENVELOPE -->
  <section class="intro-screen" id="introScreen">
    <div class="intro-card">
      <div class="intro-title">L & N</div>
      <p class="intro-subtitle">Convite especial</p>

      <div class="envelope-wrap" id="envelopeWrap" aria-label="Abrir convite">
        <div class="letter-peek"></div>
        <div class="envelope">
          <div class="envelope-left"></div>
          <div class="envelope-right"></div>
        </div>
        <div class="wax-seal">L&nbsp;&amp;&nbsp;N</div>
      </div>

      <button class="open-invite" id="openInvite">Toque para abrir</button>
      <p class="intro-hint">Um convite preparado com carinho para você.</p>
    </div>
  </section>

  <!-- SITE PRINCIPAL -->
  <main class="site" id="siteContent">
    <section class="hero" id="inicio">
      <div class="hero-panel">
        <div class="monogram">L & N</div>
        <p class="eyebrow">Nosso momento especial</p>
        <h1>Lorena & Nome</h1>
        <div class="hero-date">17 de Outubro de 2026</div>
        <p class="hero-text">
          Criamos este espaço para compartilhar com vocês os detalhes da nossa comemoração.
          Será um momento simples, especial e cheio de significado, para celebrar nossa união no civil
          ao lado de pessoas importantes para nós.
        </p>
        <div class="actions">
          <a href="#confirmar" class="btn btn-primary">Confirmar presença</a>
          <a href="#presentes" class="btn btn-secondary">Lista de presentes</a>
        </div>
      </div>
    </section>

    <section class="section" id="detalhes">
      <div class="container">
        <div class="section-title">
          <span>Informações</span>
          <h2>Detalhes da comemoração</h2>
        </div>

        <div class="cards-grid">
          <article class="card">
            <div class="card-icon">📅</div>
            <h3>Data</h3>
            <p>17 de outubro de 2026. Após o casamento civil, iremos celebrar com um churrasco especial.</p>
          </article>

          <article class="card">
            <div class="card-icon">📍</div>
            <h3>Local</h3>
            <p>Sitio Recanto das Palmeiras - Garcias - Itaúna/MG</p>
          </article>

          <article class="card">
            <div class="card-icon">🤎</div>
            <h3>Traje</h3>
            <p>Venha confortável e elegante. O mais importante é ter você presente nesse momento.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="programacao">
      <div class="container">
        <div class="section-title">
          <span>Roteiro</span>
          <h2>Programação</h2>
        </div>

        <div class="timeline">
          <div class="timeline-item">
            <div class="timeline-time">11h00</div>
            <div class="timeline-content">
              <h3>Recepção dos convidados</h3>
              <p>Momento de chegada, fotos e boas-vindas.</p>
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-time">13h00</div>
            <div class="timeline-content">
              <h3>Cerimônia & Churrasco de comemoração</h3>
              <p>Uma celebração leve, íntima e especial para marcar nossa união.</p>
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-time">15h00</div>
            <div class="timeline-content">
              <h3>Fotos e agradecimentos</h3>
              <p>Registro dos momentos especiais com todos que fazem parte da nossa história.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="presentes">
      <div class="container">
        <div class="section-title">
          <span>Carinho</span>
          <h2>Lista de presentes</h2>
        </div>

        <div class="gift-box">
          <p>
            Sua presença já é muito especial para nós. Mas, se desejar nos presentear,
            preparamos uma lista com opções escolhidas com carinho para essa nova fase.
          </p>
          <a href="https://www.seulinkdalista.com.br" target="_blank" class="btn btn-primary">Acessar lista</a>
        </div>
      </div>
    </section>

    <section class="section" id="confirmar">
      <div class="container">
        <div class="section-title">
          <span>Confirmação</span>
          <h2>Confirme sua presença</h2>
        </div>

        <form class="rsvp-form" id="rsvpForm">
          <div>
            <label for="nome">Seu nome</label>
            <input type="text" id="nome" placeholder="Digite seu nome completo" required>
          </div>

          <div>
            <label for="presenca">Você poderá comparecer?</label>
            <select id="presenca" required>
              <option value="">Selecione uma opção</option>
              <option value="Sim, confirmo minha presença">Sim, confirmo minha presença</option>
              <option value="Infelizmente não poderei ir">Infelizmente não poderei ir</option>
            </select>
          </div>

          <div>
            <label for="mensagem">Mensagem opcional</label>
            <textarea id="mensagem" placeholder="Deixe uma mensagem para os noivos"></textarea>
          </div>

          <button type="submit" class="submit-btn">Enviar confirmação pelo WhatsApp</button>
        </form>
      </div>
    </section>

    <footer>
      <div class="footer-logo">L & N</div>
      <p>Com carinho, Lorena & Naiara.</p>
    </footer>
  </main>

  <script>
    const introScreen = document.getElementById('introScreen');
    const siteContent = document.getElementById('siteContent');
    const openInvite = document.getElementById('openInvite');
    const envelopeWrap = document.getElementById('envelopeWrap');
    const rsvpForm = document.getElementById('rsvpForm');

    function abrirConvite() {
      introScreen.classList.add('opened');
      siteContent.classList.add('visible');
      setTimeout(() => {
        introScreen.classList.add('hidden');
      }, 950);
    }

    openInvite.addEventListener('click', abrirConvite);
    envelopeWrap.addEventListener('click', abrirConvite);

    rsvpForm.addEventListener('submit', function(event) {
      event.preventDefault();

      const telefoneNoivas = '5537984189939'; // TROQUE PELO SEU WHATSAPP COM DDD. Exemplo: 5537999999999
      const nome = document.getElementById('nome').value;
      const presenca = document.getElementById('presenca').value;
      const acompanhantes = document.getElementById('acompanhantes').value || '0';
      const mensagem = document.getElementById('mensagem').value || 'Sem mensagem adicional.';

      const texto = `Olá! Gostaria de confirmar minha presença no casamento.\n\nNome: ${nome}\nConfirmação: ${presenca}\nAcompanhantes: ${acompanhantes}\nMensagem: ${mensagem}`;
      const link = `https://wa.me/${telefoneNoivos}?text=${encodeURIComponent(texto)}`;

      window.open(link, '_blank');
    });
  </script>
</body>
